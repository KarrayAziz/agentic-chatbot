# Google Gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Tavily web search
TAVILY_API_KEY=

# LangSmith tracing (optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-chatbot
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Only needed when an API key has access to multiple LangSmith workspaces.
LANGSMITH_WORKSPACE_ID=

# Application
LOG_LEVEL=INFO
CHECKPOINT_DB_PATH=data/langgraph_checkpoints.sqlite
CONVERSATION_DB_PATH=data/conversations.sqlite
CHROMA_DB_PATH=data/chroma
